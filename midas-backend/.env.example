# Servidor
NODE_ENV=development
PORT=4000

# Base de datos (PostgreSQL local)
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5433/midas_db?schema=public"
# Conexión directa para migraciones (en Neon: el host SIN "-pooler"). En local, igual a DATABASE_URL.
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5433/midas_db?schema=public"

# CORS: origen del frontend (Vite usa 5173 por defecto)
CORS_ORIGIN=http://localhost:5173

# Zona horaria de la barbería (IANA)
BUSINESS_TIMEZONE=America/Bogota
# Días hacia adelante en los que se puede reservar
BOOKING_WINDOW_DAYS=60

# Nº de proxies delante del API (0 en local; 1 detrás de Render; 2 con Vercel + Render)
TRUST_PROXY=0
# strict (recomendado) | lax | none (solo si front y API están en dominios distintos; exige HTTPS)
COOKIE_SAMESITE=strict

# Autenticación (JWT en cookie HttpOnly)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin inicial (npx prisma db seed)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true = crea servicios y barberos de demostración al ejecutar el seed
SEED_DEMO=false

# Cloudinary (fotos de resultados). Sin estas variables la subida responde 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (VAPID). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@midas.com
# Recordatorios 15 min antes (activar en UNA sola instancia si hay varias)
REMINDERS_ENABLED=true
